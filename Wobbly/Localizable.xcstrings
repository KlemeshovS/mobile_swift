        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пирамида Хеопса"
          }
        }
      }
    },
    "ach_milestone_202_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narrow, deep, dark. Just like your life after Friday."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Узкая, глубокая, тёмная. Как твоя жизнь после пятницы."
          }
        }
      }
    },
    "ach_milestone_202_negative_title" : {
      "extractionState" : "manual",
