    "ach_review_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You left a review. Not because you're nice. Because you want someone else to survive this too. That's almost altruism. Almost."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты оставил отзыв. Не потому что добрый. А потому что хочешь, чтобы кто-то ещё тоже это пережил. Это почти альтруизм. Почти."
          }
        }
      }
    },
    "ach_review_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
