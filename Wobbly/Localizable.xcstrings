    "ach_milestone_8848_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're on top of the world. Could have just stayed sober for six months. Just kidding, well done!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты на крыше мира. Обратный билет - пешком. Главное, не расслабляйся."
          }
        }
      }
    },
    "ach_milestone_8848_title" : {
