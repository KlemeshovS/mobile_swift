    },
    "status_weekend_warrior_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From Monday to Friday you are a model of virtue, on Saturday you are a neighborhood legend, on Sunday you are a helpless body."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С понедельника по пятницу ты образец добродетели, в субботу — легенда района, в воскресенье — беспомощное тело."
          }
        }
      }
    },
