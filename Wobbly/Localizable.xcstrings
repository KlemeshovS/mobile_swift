    "status_active_lifestyle_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You voluntarily suffer in the gym so you can suffer from a hangover with a clear conscience. The circle of torment is complete!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ты страдаешь в зале, чтобы потом с чистой совестью страдать от похмелья. Круг страданий замкнулся!"
          }
        }
      }
    },
    "status_active_lifestyle_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitness Martyr"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Фитнес-мученик"
          }
        }
      }
    },
    "status_alcoholic_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your liver is crying, but you stubbornly ignore its pleas. The bartender knows you by name, and the morning starts with the question \"what happened yesterday?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя печень плачет, но ты упорно не слышишь её мольбы. Бармен знает тебя по имени, а утро начинается с вопроса «что вчера было?»."
          }
        }
      }
    },
    "status_alcoholic_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional Hangover"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "КМС по алкоспорту"
          }
        }
      }
    },
    "status_alko_cyborg_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cyborg who doesn't drink is just scrap metal. You're on fire!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Киборг, который не пьёт — просто железка."
          }
        }
      }
    },
    "status_alko_cyborg_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcocyberg"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Алкокиборг"
          }
        }
      }
    },
    "status_balanced_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You drink just enough to not have fun, and exercise just enough to see no results. Perfect!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты пьёшь ровно столько, чтобы не было весело, и занимаешься спортом ровно столько, чтобы не было результата. Идеально!"
          }
        }
      }
    },
    "status_balanced_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderate and Boring"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ровный аж тошнит"
          }
        }
      }
    },
    "status_boring_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've found the perfect balance between doing nothing and pretending to do something. Master of boring perfection!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя жизнь настолько предсказуема, что даже календарь завидует. Никаких крайностей — только стабильная скука изо дня в день."
          }
        }
      }
    },
    "status_boring_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring as a Cork"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скучный как пробка"
          }
        }
      }
    },
    "status_moderate_drinker_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You drink just enough not to feel guilty, but enough to justify your existence. The art of petty sin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты пьёшь ровно столько, чтобы не чувствовать вину, но достаточно, чтобы оправдать своё существование. Искусство мелкого греха."
          }
        }
      }
    },
    "status_moderate_drinker_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekend Sinner"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грешник выходного дня"
          }
        }
      }
    },
    "status_party_animal_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your party exploits become legends, and your morning suffering becomes epic poems. Hero of Saturday night and victim of Sunday morning!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Твои вечеринки войдут в историю, а твоё похмелье — в книгу рекордов. Ты не просто тусовщик, ты — легенда!"
          }
        }
      }
    },
    "status_party_animal_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Party Legend"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тусовщик-легенда"
          }
        }
      }
    },
    "status_sober_enthusiast_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You run from alcohol faster than from responsibility. The gym is your refuge from reality and parties."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты бежишь от алкоголя быстрее, чем от ответственности. Спортзал — твоё убежище от реальности и вечеринок."
          }
        }
      }
    },
    "status_sober_enthusiast_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sober Sadist"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трезвый садист"
          }
        }
      }
    },
    "status_sports_fanatic_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You worship iron idols, sacrificing your time, strength, and ability to walk normally the next day. Cult of pain!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ты поклоняешься железным богам, принося им в жертву своё время, силы и возможность нормально ходить после тренировок."
          }
        }
      }
    },
    "status_sports_fanatic_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slave of the Iron Temple"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Раб железного храма"
          }
        }
      }
    },
    "status_sporty_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You prefer sneakers to wine glasses, but sometimes allow yourself a 'sports' beer after a workout!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ты больше любишь кроссовки, чем бокалы, но иногда позволяешь себе «спортивное» пиво после тренировки!"
          }
        }
      }
    },
    "status_sporty_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friendly Athlete"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Любитель зарядки"
          }
        }
      }
    },
    "status_weekend_warrior_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From Monday to Friday you are a model of virtue, on Saturday you are a neighborhood legend, on Sunday you are a helpless body."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С понедельника по пятницу ты образец добродетели, в субботу — легенда района, в воскресенье — беспомощное тело."
          }
        }
      }
    },
    "status_weekend_warrior_title" : {
      "extractionState" : "manual",
      "localizations" : {
