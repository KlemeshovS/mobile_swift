    "ach_sober_days_year_100_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 sober days. Your colleagues are taking notes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "100 дней без алкоголя. Коллеги смотрят с подозрением."
          }
        }
      }
    },
    "ach_sober_days_year_100_title" : {
      "extractionState" : "manual",
