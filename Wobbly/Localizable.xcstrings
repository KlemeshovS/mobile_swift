          }
        }
      }
    },
    "ach_sober_days_year_200_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "200 sober days. You don't drink. But you know where all your friends live."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "200 дней. Ты не пьешь и знаешь где живут все твои друзья."
          }
        }
      }
    },
    "ach_sober_days_year_200_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
