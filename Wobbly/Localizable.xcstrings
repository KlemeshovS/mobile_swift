    "ach_sober_30_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You remember going to bed. And getting up. And everything in between."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты помнишь, как лег спать. И как встали. И всё между."
          }
        }
      }
    },
    "ach_sober_30_title" : {
