          }
        }
      }
    },
    "ach_milestone_1642_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The deepest freshwater lake. Your body is now fresh. And dead."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Самое глубокое пресное озеро. Твой организм теперь тоже пресный. И мёртвый."
          }
        }
      }
    },
    "ach_milestone_1642_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
