    "about_creator_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The creator, who still doesn't know whether to be proud or to cry."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создатель, который сам не знает, гордиться ему или плакать"
          }
        }
      }
    },
    "ach_drink_3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three days in a row in the dark? Survived? You're a professional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три дня подряд во тьме? Выжил? Ты — профессионал."
          }
        }
      }
    },
    "ach_drink_3_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survival Pro"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профи выживания"
          }
        }
      }
    },
    "ach_drink_7_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 days non-stop? Your liver has already sent an SOS signal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 дней без передышки? Твоя печень уже подала сигнал SOS."
          }
        }
      }
    },
    "ach_drink_7_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Master of Morning Shame"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мастер утреннего стыда"
          }
        }
      }
    },
    "ach_drink_14_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every weekend you sponsor someone's yacht"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждые выходные ты спонсируешь чью-то яхту"
          }
        }
      }
    },
    "ach_drink_14_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patron of the Alcohol Industry"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меценат алкогольной индустрии"
          }
        }
      }
    },
    "ach_drink_30_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You know 1001 ways to come back to life in the morning"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты знаешь 1001 способ ожить с утра"
          }
        }
      }
    },
    "ach_drink_30_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morning Survival Expert"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эксперт по Утреннему Выживанию"
          }
        }
      }
    },
    "ach_drink_days_year_100_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 days in the dark. The pressure is already crushing your ribs, but you keep swimming deeper. Consistency? No. Just a habit of not surfacing."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "100 дней во тьме. Давление уже ломает рёбра, но ты продолжаешь плыть глубже. Стабильность? Нет. Просто привычка не всплывать."
          }
        }
      }
    },
    "ach_drink_days_year_100_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reliably Unreliable"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стабильно нестабилен"
          }
        }
      }
    },
    "ach_drink_days_year_200_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "200 days. Your liver stopped sending letters home. Now it just knocks from inside — morse code for «abyss accepted». You're officially cargo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "200 дней. Твоя печень перестала писать письма домой. Теперь она просто стучит изнутри — азбукой Морзе: «бездна приняла». Ты официально — груз 200."
          }
        }
      }
    },
    "ach_drink_days_year_200_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half-Year Commitment"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Груз 200"
          }
        }
      }
    },
    "ach_drink_days_year_300_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "300 drinking days. This isn't a career — it's a dive without a bottom. Your lungs are full of darkness, and you start to like the taste of pressure. Professional deformation of the soul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "300 алкодней. Это уже не карьера — это погружение без дна. Лёгкие полны тьмы, и вкус давления начинает нравиться. Профессиональная деформация души."
          }
        }
      }
    },
    "ach_drink_days_year_300_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ефремыч"
          }
        }
      }
    },
    "ach_drink_heavy_year_50_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 fully-wasted days a year. Half of those stories aren't your memories — they're other people's retellings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 дней «всрало» в году. Половина этих историй — не твои воспоминания, а чужие пересказы."
          }
        }
      }
    },
    "ach_drink_heavy_year_50_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Legend Nobody Remembers"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легенда, которую никто не помнит"
          }
        }
      }
    },
    "ach_drink_heavy_year_100_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 fully-blackout days a year — over a quarter of your life offline. Rock bottom already has your name on the mailbox."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 дней «всрало» за год — больше четверти жизни в отключке. У дна для тебя уже готова прописка."
          }
        }
      }
    },
    "ach_drink_heavy_year_100_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honorary Resident of Rock Bottom"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почётный Житель Дна"
          }
        }
      }
    },
    "ach_drink_little_year_50_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 days a year of \"it's just a little.\" Your liver started counting, and it's not a fan of the trend."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 дней в году «ну это же чуть-чуть». Твоя печень завела счётчик — и он ей не нравится."
          }
        }
      }
    },
    "ach_drink_little_year_50_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Master of Just a Little"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мастер Чуть-Чуть"
          }
        }
      }
    },
    "ach_drink_little_year_100_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 \"just a little\" days a year. That's basically a second job now. The pay is a mild hangover and concerned looks from friends."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 дней «чучуть» за год — это уже вторая работа. Зарплата: лёгкое похмелье и вопросы от близких."
          }
        }
      }
    },
    "ach_drink_little_year_100_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sipping Champion"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чемпион Дегустаций"
          }
        }
      }
    },
    "ach_drink_medium_year_50_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 medium-level days a year. The bartender pours your drink before you even sit down."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 средних дней в году. Бармен наливает твой напиток раньше, чем ты успеваешь сесть."
          }
        }
      }
    },
    "ach_drink_medium_year_50_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular, Moderately"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завсегдатай Средней Руки"
          }
        }
      }
    },
    "ach_drink_medium_year_100_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 medium days a year. Your liver now works without weekends or vacation."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 средних дней за год. Твоя печень теперь работает без выходных и без отпуска."
          }
        }
      }
    },
    "ach_drink_medium_year_100_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customer of the Month, Every Month"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клиент Месяца"
          }
        }
      }
    },
    "ach_milestone_146_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens of thousands of slaves built this without water or whiskey. You just climbed it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Десятки тысяч рабов строили это без воды и виски. А ты просто поднялся."
          }
        }
      }
    },
    "ach_milestone_146_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Great Pyramid of Giza"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пирамида Хеопса"
          }
        }
      }
    },
    "ach_milestone_202_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narrow, deep, dark. Just like your life after Friday."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Узкая, глубокая, тёмная. Как твоя жизнь после пятницы."
          }
        }
      }
    },
    "ach_milestone_202_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Blue Hole"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Голубая дыра"
          }
        }
      }
    },
    "ach_milestone_319_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spire is sharper than your craving for a drink."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шпиль острее, чем твоя тоска по рюмке"
          }
        }
      }
    },
    "ach_milestone_319_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chrysler Building"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крайслер-билдинг"
          }
        }
      }
    },
    "ach_milestone_443_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "King Kong climbed it for a blonde. You did it for an achievement and zero drinks."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кинг-Конг карабкался сюда ради красотки. А ты — ради ачивки и без выпивки."
          }
        }
      }
    },
    "ach_milestone_443_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empire State Building"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эмпайр-стейт-билдинг"
          }
        }
      }
    },
    "ach_milestone_1234_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You climbed, sweated, stayed sober. The reward? A view of Yalta. Worth it?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимался, потел, не пил. Итог - вид на Ялту. Оно того стоило?"
          }
        }
      }
    },
    "ach_milestone_1234_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai-Petri"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ай-Петри"
          }
        }
      }
    },
    "ach_milestone_1642_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The deepest freshwater lake. Your body is now fresh. And dead."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Самое глубокое пресное озеро. Твой организм теперь тоже пресный. И мёртвый."
          }
        }
      }
    },
    "ach_milestone_1642_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lake Baikal"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Байкал"
          }
        }
      }
    },
    "ach_milestone_1917_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highest peak of the White Mountains. Named after a president who didn't drink. Coincidence?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Высшая точка Аппалачей. Названа в честь президента, который не пил. Совпадение?"
          }
        }
      }
    },
    "ach_milestone_1917_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mount Washington"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Гора Вашингтон"
          }
        }
      }
    },
    "ach_milestone_3491_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highest peak of the Sayans. Locals say there are 3491 steps of sobriety to the top. Locals lie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Высшая точка Саян. Местные говорят, что туда ведут 3491 ступенька трезвости. Местные врут."
          }
        }
      }
    },
    "ach_milestone_3491_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munku-Sardyk"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Мунку-Сардык"
          }
        }
      }
    },
    "ach_milestone_3800_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titanic's icy grave. And yours — in progress."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ледяная могила Титаника. И твоя - в процессе."
          }
        }
      }
    },
    "ach_milestone_3800_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Titanic"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Титаник"
          }
        }
      }
    },
    "ach_milestone_4478_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most beautiful peak in the Alps. The Swiss look at it sober. Because watches are expensive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Красивейшая гора Альп. Швейцарцы смотрят на неё трезво. Потому что часы дорогие."
          }
        }
      }
    },
    "ach_milestone_4478_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matterhorn"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Маттерхорн"
          }
        }
      }
    },
    "ach_milestone_4506_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altai, Lake Akkemskoe, shamans and mysticism. Shamans don't drink either. Well, almost."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Алтай, Аккемское озеро, мистика и шаманы. Шаманы тоже не пьют. Ну почти."
          }
        }
      }
    },
    "ach_milestone_4506_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belukha"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Белуха"
          }
        }
      }
    },
    "ach_milestone_4810_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sport, sobriety, discipline. You made it to the top. Where's the champagne? Oh right, not allowed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Спорт, трезвость, дисциплина. И вот ты на вершине. Где шампанское? А, нельзя."
          }
        }
      }
    },
    "ach_milestone_4810_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mont Blanc"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Монблан"
          }
        }
      }
    },
    "ach_milestone_5054_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the border of Russia and Georgia. Both sides pour generously. You resisted. Prometheus would approve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На границе России и Грузии. С обеих сторон наливают. Ты устоял. Прометей оценил бы."
          }
        }
      }
    },
    "ach_milestone_5054_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazbek"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Казбек"
          }
        }
      }
    },
    "ach_milestone_5642_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So many weeks sober, mountain lungs. Little oxygen, but a clear conscience."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Столько недель без алкоголя. Кислорода мало, зато совесть чиста."
          }
        }
      }
    },
    "ach_milestone_5642_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elbrus"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Эльбрус"
          }
        }
      }
    },
    "ach_milestone_6066_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Ring of Fire. Your liver is now at the epicenter too."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Огненный пояс Земли. Твоя печень сейчас тоже в эпицентре."
          }
        }
      }
    },
    "ach_milestone_6066_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atacama Trench"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Атакамская впадина"
          }
        }
      }
    },
    "ach_milestone_7010_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the sky is higher. But there's no bar there either. At least the view's nice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выше только небо. Но там тоже нет бара. Зато есть вид."
          }
        }
      }
    },
    "ach_milestone_7010_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khan Tengri"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хан Тенгри"
          }
        }
      }
    },
    "ach_milestone_7729_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't wake up — you surface, provided the pressure shift doesn't burst your lungs. Now lie still in the dark and listen to the abyss gnaw on your bones."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ты не проснешься — ты всплывёшь, если перепады давления не разорвут лёгкие. А пока лежи в этой темноте и слушай, как бездна жуёт твои кости."
          }
        }
      }
    },
    "ach_milestone_7729_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunda Trench"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зондский желоб"
          }
        }
      }
    },
    "ach_milestone_8848_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're on top of the world. Could have just stayed sober for six months. Just kidding, well done!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты на крыше мира. Обратный билет - пешком. Главное, не расслабляйся."
          }
        }
      }
    },
    "ach_milestone_8848_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everest"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Эверест"
          }
        }
      }
    },
    "ach_milestone_10047_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The deep-sea robot Nereus got crushed here. But you? Tough nut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Здесь раздавило глубоководного «Нерея». А ты - ничего, крепкий орешек."
          }
        }
      }
    },
    "ach_milestone_10047_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kermadec Trench"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кермадек"
          }
        }
      }
    },
    "ach_milestone_11022_negative_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're at the bottom. Literally. It can't get worse. Or can it?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ты на дне. Буквально. Хуже уже не будет. Или будет?"
          }
        }
      }
    },
    "ach_milestone_11022_negative_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mariana Trench"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Марианская впадина"
          }
        }
      }
    },
    "ach_milestone_20000_negative_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20,000 meters — deeper than the Mariana Trench, deeper than anything that actually exists on Earth. This is where the underworld begins, and Hades is waiting for you with a stone-cold sober stare. Charon doesn't take coins down here — only excuses."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "20 000 метров — глубже Марианской впадины, глубже всего, что вообще существует на Земле. Здесь начинается царство мёртвых, и Аид уже ждёт тебя с трезвым взглядом. Харон в этих водах денег не берёт — только оправдания."
          }
        }
      }
    },
    "ach_milestone_20000_negative_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visiting Hades"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В гостях у Аида"
          }
        }
      }
    },
    "ach_milestone_21900_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "21,900 meters — the tallest volcano in the entire Solar System, and it's not even on Earth, it's on Mars. You've climbed higher than the gods of Olympus themselves, higher than the atmosphere, higher than any excuse to drink. Too bad nectar and ambrosia don't count as an open bar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "21 900 метров — самый высокий вулкан во всей Солнечной системе, и он не на Земле, а на Марсе. Ты поднялся выше богов Олимпа, выше атмосферы, выше любых оправданий выпить. Жаль, нектар и амброзия — это не открытый бар."
          }
        }
      }
    },
    "ach_milestone_21900_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olympus Mons"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Гора Олимп"
          }
        }
      }
    },
    "ach_no_hangover_90_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 days without a hangover. That's a full quarter. Time to file a report: \"Sobriety — completed. Results — unclear. Next quarter — repeat.\" Your boss would be proud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Целый квартал. Пора сдавать отчёт: «Трезвость — выполнена. Результаты — неясны. Следующий квартал — повторить». Начальник бы гордился."
          }
        }
      }
    },
    "ach_no_hangover_90_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reporting Period"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отчётный период"
          }
        }
      }
    },
    "ach_no_hangover_180_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half a year, no hangovers. No morning regrets. And no funny stories either — because funny stories only happen after the third drink. But hey, at least you remember everything. Everything."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пол год никакого похмелья. Никаких утренних сожалений. И смешных историй тоже нет. Зато ты всё помнишь. Всё."
          }
        }
      }
    },
    "ach_no_hangover_180_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgotten Taste of Shame"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Забытый вкус стыда"
          }
        }
      }
    },
    "ach_no_hangover_365_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A whole year. You don't even remember the pain anymore. Just a vague legend from another life. Your friends still drink. But you? You're a fossil of sobriety."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Целый год без похмелья. Ты уже не помнишь боли. Только смутная легенда из другой жизни. Твои друзья всё ещё пьют. А ты? Ты — ископаемое трезвости."
          }
        }
      }
    },
    "ach_no_hangover_365_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory of a Hangover"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Память о похмелье"
          }
        }
      }
    },
