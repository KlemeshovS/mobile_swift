    },
    "ach_milestone_6066_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Ring of Fire. Your liver is now at the epicenter too."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Огненный пояс Земли. Твоя печень сейчас тоже в эпицентре."
          }
        }
      }
    },
    "ach_milestone_6066_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
