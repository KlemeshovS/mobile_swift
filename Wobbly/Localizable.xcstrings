    "alcohol_chart_info_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chart shows your cumulative alcohol score for the current month.\n\nPoints are based on intake level:\n• A little — 1 pt\n• Moderate — 3 pts\n• Heavy — 5 pts\n\nThe higher the line, the more alcohol this month."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "График показывает накопленное количество баллов за текущий месяц.\n\nБаллы начисляются по степени употребления:\n• Чуть-чуть — 1 балл\n• Средне — 3 балла\n• Всё плохо — 5 баллов\n\nЧем выше линия, тем больше алкоголя за месяц."
          }
        }
      }
    },
