    "ach_milestone_10047_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The deep-sea robot Nereus got crushed here. But you? Tough nut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Здесь раздавило глубоководного «Нерея». А ты - ничего, крепкий орешек."
