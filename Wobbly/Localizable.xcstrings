          }
        }
      }
    },
    "ach_milestone_319_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spire is sharper than your craving for a drink."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шпиль острее, чем твоя тоска по рюмке"
          }
        }
      }
    },
    "ach_milestone_319_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chrysler Building"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крайслер-билдинг"
          }
        }
      }
    },
    "ach_milestone_443_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "King Kong climbed it for a blonde. You did it for an achievement and zero drinks."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кинг-Конг карабкался сюда ради красотки. А ты — ради ачивки и без выпивки."
          }
        }
      }
    },
    "ach_milestone_443_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empire State Building"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эмпайр-стейт-билдинг"
          }
        }
      }
    },
    "ach_milestone_1234_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You climbed, sweated, stayed sober. The reward? A view of Yalta. Worth it?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поднимался, потел, не пил. Итог - вид на Ялту. Оно того стоило?"
          }
        }
      }
    },
    "ach_milestone_1234_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
