    "motivation_drinking_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wallet isn't elastic. Your bank balance is at rock bottom, just like you were yesterday."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кошелёк не резиновый. Твой баланс на дне, как и ты после вчерашнего."
          }
        }
      }
    },
    "motivation_drinking_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your liver has already sent out an SOS. Maybe give it a day off?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя печень уже отправила SOS. Может, дашь ей выходной?"
          }
        }
      }
    },
    "motivation_drinking_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your liver is crying. You're not, because you're dehydrated."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя печень плачет. А ты нет, потому что обезвожен."
          }
        }
      }
    },
    "motivation_drinking_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your blood alcohol level is already higher than your IQ"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой уровень алкоголя в крови уже выше, чем твой IQ"
          }
        }
      }
    },
    "motivation_drinking_5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not drinking — the drink is drinking you. Take back the reins"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не ты бухаешь, а бухает тебя. Возьми бразды правления обратно."
          }
        }
      }
    },
    "motivation_drinking_6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body is already on strike. Do you want it to file for resignation?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой организм уже бастует. Хочешь, чтобы он подал заявление по собственному?"
          }
        }
      }
    },
    "motivation_drinking_7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breakfast of Citramon and shame — is that your signature recipe? Let's try a new one."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завтрак из цитрамона и стыда — это твой фирменный рецепт? Давай попробуем новый."
          }
        }
      }
    },
    "motivation_drinking_8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've blown all your cash and your health. Congrats, you're the proud sponsor of your own hangover."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты просадил все бабки и здоровье. Поздравляю, ты спонсор собственного похмелья."
          }
        }
      }
    },
    "motivation_drinking_9" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallet empty, head pounding, vision blurry. Just a regular weekend, huh?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кошелёк пуст, голова болит, в глазах пелена. Нормальный выходной, чё."
          }
        }
      }
    },
    "motivation_drinking_10" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your morning ritual: \"Where am I?\", \"Who am I?\", \"Why?\". Just like a Buddhist monk, but without the enlightenment."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой утренний ритуал: «где я?», «кто я?», «за что?». Прям как у буддийского монаха, только без просветления."
          }
        }
      }
    },
    "motivation_drinking_11" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your brain is already seeking political asylum in another head"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои мозги уже просят политического убежища в другой голове."
          }
        }
      }
    },
    "motivation_drinking_12" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've crossed every line. Even the \"totally wasted\" line. Welcome to the binge!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты перешел все границы. Даже границу «всрало». Добро пожаловать в запой!"
          }
        }
      }
    },
    "motivation_drinking_13" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're drinking away not just your money, but your face too. Soon your passport photo will be scarier than real life."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты пропиваешь не только деньги, но и лицо. Скоро в паспорте будешь страшнее, чем в жизни."
          }
        }
      }
    },
    "motivation_drinking_14" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yesterday's motto: \"Drink to the bottom!\" And you did. Even the bottom filed a complaint about you."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой вчерашний девиз: «Пить до дна!». И ты допил. Даже дно пожаловалось на тебя в администрации."
          }
        }
      }
    },
    "motivation_drinking_15" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yesterday you conducted a sociological study: \"How people live without brains.\" Today it's time for conclusions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты вчера провел социологическое исследование «Как люди живут без мозгов». Сегодня пришло время для выводов."
          }
        }
      }
    },
    "motivation_drinking_16" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Went all out again? Tomorrow your clear head will thank you. Or not."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снова вписались на полную? Завтра голова ясная будет благодарить. Или нет."
          }
        }
      }
    },
    "motivation_drinking_17" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check out the calendar. This one's \"totally wasted,\" this one's not. Which do you like better?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зацени календарь. Вот это всрало, а это нет. Чё больше нравится?"
          }
        }
      }
    },
    "motivation_sober_1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not getting wasted, you're enjoying life. Others don't have the strength for that."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не бухаешь, ты кайфуешь. Остальным на это сил не хватает."
          }
        }
      }
    },
    "motivation_sober_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not a loser who can't afford it. You're a king who can, but chooses not to.💪"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не лох, который не может позволить. Ты царь, который может, но не хочет.💪"
          }
        }
      }
    },
    "motivation_sober_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your morning routine: waking up, not surviving. Victory."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой утренний режим — проснуться, а не выжить. Победа."
          }
        }
      }
    },
    "motivation_sober_4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Many in your place would have cracked. But you're handling the pressure and the glasses."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На твоём месте уже многие бы сломались. А ты держишь удар и стаканы."
          }
        }
      }
    },
    "motivation_sober_5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You didn't drink, which means tomorrow you'll wake up with only one pain — existential."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не пил, а значит, завтра ты проснешься с единственной болью — экзистенциальной"
          }
        }
      }
    },
    "motivation_sober_6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While everyone's chilling in the bathroom, you're chilling in life. The win is obvious."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока все тусят в сортире, ты тусишь в жизни. Выигрыш очевиден."
          }
        }
      }
    },
    "motivation_sober_7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not boring, you're sane. It's the new black, others just aren't in the loop."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не скучный, ты адекватный. Это новый чёрный, остальные просто не в теме."
          }
        }
      }
    },
    "motivation_sober_8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have plans in the morning, they have a sentence. Feel the difference?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя утром планы, а у них — приговор. Чувствуешь разницу?"
          }
        }
      }
    },
    "motivation_sober_9" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not poisoning yourself with crap. Looks like your self-preservation instinct kicked in. Nice one."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты не травишь себя всякой дрянью. Похоже, у тебя включился инстинкт самосохранения. Красава."
          }
        }
      }
    },
    "motivation_sober_10" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While they're flushing cash down the toilet, you're saving up for something awesome. Who's winning?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока они сливают бабки в унитаз, ты копишь на что-то охуенное. Кто кого?"
          }
        }
      }
    },
    "motivation_sober_11" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at that, you've got money in your wallet. Probably multiplied while you weren't drinking."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотри-ка, а у тебя в кошельке завелись деньги. Наверное, размножились, пока ты не бухал."
          }
        }
      }
    },
    "motivation_sober_12" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your calendar is clean of shame. Looks suspicious... Maybe you just forgot to mark it?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твой календарь чист от позора. Выглядит подозрительно... Может, просто забыл отметить?"
          }
        }
      }
    },
    "motivation_sober_13" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've saved so much on alcohol that now you can buy yourself... one good sock. Life's looking up!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты сэкономил на алкоголе столько, что теперь можешь купить себе... один хороший носок. Жизнь налаживается!"
          }
        }
      }
    },
    "motivation_sober_14" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've got a clear head and a full wallet in the morning. Looking suspiciously successful."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У тебя с утра ясная голова и полный кошелёк. Выглядишь подозрительно успешным."
          }
        }
      }
    },
    "motivation_sober_15" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've got an extra thousand in your pocket and extra years in reserve. What are you gonna do?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебя ждёт лишняя тысяча в кармане и лишние годы в запасе. Чё будешь делать?"
