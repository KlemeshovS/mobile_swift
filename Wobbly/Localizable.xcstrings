    },
    "ach_milestone_7010_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the sky is higher. But there's no bar there either. At least the view's nice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выше только небо. Но там тоже нет бара. Зато есть вид."
          }
        }
      }
    },
    "ach_milestone_7010_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khan Tengri"
