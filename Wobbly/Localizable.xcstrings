        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "КМС по алкоспорту"
          }
        }
      }
    },
    "status_alko_cyborg_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cyborg who doesn't drink is just scrap metal. You're on fire!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Киборг, который не пьёт — просто железка."
