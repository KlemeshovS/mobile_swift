    },
    "status_sober_enthusiast_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You run from alcohol faster than from responsibility. The gym is your refuge from reality and parties."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты бежишь от алкоголя быстрее, чем от ответственности. Спортзал — твоё убежище от реальности и вечеринок."
          }
        }
      }
    },
    "status_sober_enthusiast_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
