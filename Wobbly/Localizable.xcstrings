    "ach_drink_3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three days in a row in the dark? Survived? You're a professional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три дня подряд во тьме? Выжил? Ты — профессионал."
