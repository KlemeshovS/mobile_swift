          }
        }
      }
    },
    "ach_milestone_3800_negative_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titanic's icy grave. And yours — in progress."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ледяная могила Титаника. И твоя - в процессе."
          }
        }
      }
    },
    "ach_milestone_3800_negative_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Titanic"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Титаник"
          }
        }
      }
    },
    "ach_milestone_4810_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sport, sobriety, discipline. You made it to the top. Where's the champagne? Oh right, not allowed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Спорт, трезвость, дисциплина. И вот ты на вершине. Где шампанское? А, нельзя."
          }
        }
      }
    },
    "ach_milestone_4810_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mont Blanc"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Монблан"
          }
        }
      }
    },
    "ach_milestone_5642_desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So many weeks sober, mountain lungs. Little oxygen, but a clear conscience."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Столько недель без алкоголя. Кислорода мало, зато совесть чиста."
          }
        }
      }
    },
    "ach_milestone_5642_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
