    "ach_milestone_146_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tens of thousands of slaves built this without water or whiskey. You just climbed it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Десятки тысяч рабов строили это без воды и виски. А ты просто поднялся."
          }
        }
      }
    },
    "ach_milestone_146_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
