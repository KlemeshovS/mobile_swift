    "status_alcoholic_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your liver is crying, but you stubbornly ignore its pleas. The bartender knows you by name, and the morning starts with the question \"what happened yesterday?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя печень плачет, но ты упорно не слышишь её мольбы. Бармен знает тебя по имени, а утро начинается с вопроса «что вчера было?»."
          }
        }
      }
    },
