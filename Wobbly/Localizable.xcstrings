          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трезвый садист"
          }
        }
      }
    },
    "status_sports_fanatic_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You worship iron idols, sacrificing your time, strength, and ability to walk normally the next day. Cult of pain!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ты поклоняешься железным богам, принося им в жертву своё время, силы и возможность нормально ходить после тренировок."
          }
        }
      }
    },
    "status_sports_fanatic_title" : {
      "extractionState" : "manual",
